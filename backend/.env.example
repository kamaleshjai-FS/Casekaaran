# ==============================================================================
# CASEKAARAN ENVIRONMENT CONFIGURATION
# Copy to .env and configure with your active credentials
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

# Security & Admin Session
JWT_SECRET=super-secure-casekaaran-jwt-secret-key-change-in-production-2026
ADMIN_COOKIE_NAME=casekaaran_admin_token

# Supabase / PostgreSQL Database Connection
# Option 1: Full Supabase Connection String (Recommended)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option 2: Individual Supabase connection parameters
DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres
DB_SSL=true
DB_CONNECTION_LIMIT=20

